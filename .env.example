# Bible Coloring Journey — Environment Variables
# Copy this file to .env.local and fill in the values

# Payment / Checkout
# Add your Hotmart, Stripe, Gumroad, or custom payment link here
NEXT_PUBLIC_CHECKOUT_URL=

# Site URL (used for SEO and metadata)
NEXT_PUBLIC_SITE_URL=https://biblecoloringjourney.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Feature Flags (optional, override defaults)
# NEXT_PUBLIC_ENABLE_DASHBOARD=true
