{
  "manifest_version": 3,
  "name": "Flow Image Worker",
  "version": "1.0.0",
  "description": "Automatiza geração de imagens no Google Flow para o Content Studio",
  "permissions": ["storage", "downloads", "scripting", "tabs", "activeTab", "alarms", "debugger"],
  "host_permissions": [
    "https://aitestkitchen.withgoogle.com/*",
    "https://labs.google/*",
    "https://labs.google.com/*",
    "https://*.google.com/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aitestkitchen.withgoogle.com/*",
        "https://labs.google/*",
        "https://labs.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Image Worker"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
